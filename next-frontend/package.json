{
  "name": "next-frontend",
  "version": "0.4.1",
  "private": true,
  "scripts": {
    "prepare:maplibre": "node scripts/prepare-maplibre-worker.mjs",
    "predev": "npm run prepare:maplibre",
    "dev": "next dev",
