{
  "name": "trailverse-server",
  "version": "1.1.0",
  "description": "TrailVerse API - National Parks Explorer USA Backend",
  "main": "server.js",
  "scripts": {
    "start": "node --max-old-space-size=1536 server.js",
    "dev": "nodemon --legacy-watch --watch server.js --watch src --ext js,mjs,cjs,json server.js",
    "dev:mongo": "bash scripts/dev-mongo.sh",
    "seed": "node scripts/seed.js",
    "test": "npm run test:non-network",
    "test:non-network": "node scripts/run-provider-disabled-tests.js",
    "test:repair-offline": "node scripts/test-trailie-repair-offline.js",
    "test:eval-isolated": "TRAILIE_REQUIRE_EVAL_MONGO=1 node scripts/run-provider-disabled-tests.js src/eval/stage14_7/__tests__/realSubprocessLaunch.test.js",
    "test:live": "node scripts/run-live-tests.js",
    "test:watch": "node scripts/run-provider-disabled-tests.js --watch",
    "test:coverage": "node scripts/run-provider-disabled-tests.js --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:web-search": "node scripts/run-provider-disabled-tests.js src/services/__tests__/webSearchClassifier.test.js src/services/__tests__/factsWebSearchPolicy.test.js",
    "test:web-search:live": "node scripts/run-live-tests.js src/services/__tests__/factsWebSearch.live.test.js",
    "test:web-search:full": "node scripts/run-live-tests.js",
    "verify:trailie-live": "node scripts/verify-trailie-live-responses.js --save-report",
    "verify:plan-ai-flows": "node scripts/test-plan-ai-flows.js",
    "test:email": "node test-email-system.js",
    "test:email-simple": "node test-simple-email.js",
    "test:email-routes": "node test-email-routes.js",
    "setup:email": "node scripts/setup-email-system.js",
    "preview:email": "node preview-blog-email.js",
    "migrate:email": "node scripts/migrate-email-preferences.js",
    "bump:blog-views": "node scripts/bump-blog-views.js",
    "bump:blog-views:apply": "node scripts/bump-blog-views.js --apply",
    "bump:blog-recent": "node scripts/bump-recent-blog-views.js",
    "bump:blog-recent:apply": "node scripts/bump-recent-blog-views.js --apply",
    "test:evidence-persistence": "TRAILIE_TRANSACTIONAL_MONGO=1 jest src/services/__tests__/evidenceStorePersistenceTopology.test.js",
    "indexes:inventory": "node scripts/provision-application-indexes.js --inventory",
    "indexes:check": "node scripts/provision-application-indexes.js --check",
    "indexes:apply": "node scripts/provision-application-indexes.js --apply",
    "verify:release-transport": "node scripts/verify-release-transport.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.27.1",
    "@babel/register": "^7.28.3",
    "@react-email/components": "^0.5.7",
    "@react-email/render": "^1.4.0",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "handlebars": "^4.7.10",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.10.0",
    "mongoose": "^7.8.12",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "node-cache": "^5.1.2",
    "node-fetch": "2.7.0",
    "nodemailer": "10.1.1",
    "openai": "7.4.0",
    "resend": "^6.1.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "unzipper": "^0.12.3",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.0",
    "nodemon": "^3.0.3",
    "supertest": "^7.0.0",
    "validator": "^13.15.15"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    },
    "validator": "^13.15.15",
    "express-validator": {
      "validator": "^13.15.15"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
