# Add your server key here (IP-restricted):
GMAPS_SERVER_KEY=your_server_key_here

# Where Next? Beehiiv delivery (backend only; never NEXT_PUBLIC_*).
# Leave unset locally — confirmation and unsubscribe still succeed without Beehiiv.
# BEEHIIV_API_KEY=
# BEEHIIV_PUBLICATION_ID=pub_
# BEEHIIV_WEBHOOK_SECRET=whsec_
# Optional override (defaults to https://api.beehiiv.com/v2):
# BEEHIIV_API_BASE=https://api.beehiiv.com/v2

# Recreation.gov RIDB API key (free, from https://ridb.recreation.gov/)
RIDB_API_KEY=your_ridb_api_key_here

# Trailie brain selection — see docs/trailie-architecture.md
# model_first (default): intended production runtime; one request → one brain
# legacy: explicit emergency rollback only (not an alternate semantic owner)
# TRAILIE_RUNTIME=model_first
# TRAILIE_RUNTIME=legacy

# Trailie v2 Phase 0 telemetry (fail-closed/off until explicitly enabled).
TRAILIE_V2_TELEMETRY_ENABLED=false
# Use a stable, high-entropy secret in production. Never reuse this value in logs.
TRAILIE_TELEMETRY_HASH_SALT=replace_with_a_random_secret
# Minimal account-erasure audit tombstones use a separate one-way hash namespace.
ACCOUNT_ERASURE_AUDIT_SALT=replace_with_a_different_random_secret

# Separate keyed namespace for public physical-refresh correlation hashes.
# REQUIRED in any environment that serves Trailie product chat
# (TRAILIE_V2_RUNTIME_ENABLED=true). Local development: leave unset and the
# server will generate a gitignored value in server/.env on first boot.
# Production: set a durable high-entropy secret in the deployment environment.
# Never reuse this value in logs, frontend env, or source control.
TRAILIE_EVIDENCE_REFRESH_HASH_SECRET=replace_with_a_third_random_secret

# Legacy-path availability only (used when TRAILIE_RUNTIME=legacy).
# Model-first (the default TRAILIE_RUNTIME) does not consult this flag.
#   true  → legacy WP11A product chat available
#   false / unset → legacy path fails closed
TRAILIE_V2_RUNTIME_ENABLED=false

# Independent WP10 transport dialect (legacy chunk* vs v2 content_delta*). Not a generation engine.
# TRAILIE_TRANSPORT_V2=true
# NEXT_PUBLIC_TRAILIE_TRANSPORT_V2=true

# --- Database -----------------------------------------------------------
# Local development MUST use a local transactional Mongo (single-node replica
# set — evidence persistence writes inside transactions and a standalone
# mongod rejects them). Start it with: npm run dev:mongo
MONGODB_URI=mongodb://localhost:27017/trailverse-dev?replicaSet=rs0&directConnection=true
# Outside production, remote Mongo hosts are refused at startup. To knowingly
# point a dev environment at a remote cluster (NOT recommended), name each
# host explicitly:
# MONGODB_DANGEROUSLY_ALLOW_REMOTE_HOSTS=example-cluster.mongodb.net
